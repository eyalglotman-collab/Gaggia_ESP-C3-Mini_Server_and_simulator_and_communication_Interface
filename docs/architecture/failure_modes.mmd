flowchart TD
    CFG["Host-side config invalid or COM unavailable"] --> WAIT["wait_for_com_reset"]
    BRIDGE["Bridge reports blocking transport fault"] --> WAIT
    KEEP["Bridge reports keepalive_supervision_lost"] --> RETRY["retry through connect"]
    TCP["Bridge reports tcp_frame_parse_failed / tcp session loss"] --> RETRY
    COUNT["5 sequential keepalive_supervision_lost reports"] --> WAIT

    RETRY --> CONN["connect"]
    WAIT --> RESET["Reset Communication"]
    RESET --> INIT["reset -> initialize -> connect"]
