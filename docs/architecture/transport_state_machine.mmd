stateDiagram-v2
    [*] --> reset
    reset --> initialize: reset complete / self-test passed
    initialize --> connect: send mirrored Wi-Fi/TCP constants, keep SoftAP visible, and auto-start connect
    initialize --> error: COM unavailable / invalid Wi-Fi-TCP config / bridge bring-up failure
    connect --> keepalive: connect_ack / keepalive / data response received
    connect --> error: connect timeout, malformed frame, USB loss, Wi-Fi loss, TCP loss
    keepalive --> send_data: data transmit enabled after connect success
    keepalive --> error: keepalive timeout / watchdog failure
    send_data --> keepalive: keepalive command resumes supervision
    send_data --> error: keepalive timeout / watchdog failure
    error --> reset: explicit hard recovery

    state reset {
        [*] --> self_test
        self_test --> load_params
        load_params --> mirror_defaults: COM4 + visible EyalSimulatorAP + 192.168.4.1:3333
    }

    state connect {
        [*] --> wifi_ready
        wifi_ready --> tcp_session_wait
        tcp_session_wait --> wait_for_connect_response
    }
